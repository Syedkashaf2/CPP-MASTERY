
# C++ compiled binaries
*.exe
*.out
*.o
*.obj
*.a
*.so
*.dll

# Build directories
build/
cmake-build-*/
bin/
obj/

# Debug files
*.dSYM/
*.pdb
*.ilk

# Temporary files
*.tmp
*.temp
*.swp
*~

# Operating system
.DS_Store
Thumbs.db

# VS Code local workspace settings (keep shared mastery tasks & C++ build settings tracked)
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json

# Local environment files
.env
.env.*
!.env.example

# Code Runner bare executable outputs
solutions/1
problems/1

# Python cache
__pycache__/
*.py[cod]

# C++ Mastery Engine — local-only transient workspace data
.mastery/inbox/*
!.mastery/inbox/.gitkeep
.mastery/evidence/*
!.mastery/evidence/.gitkeep
.mastery/snapshots/*
!.mastery/snapshots/.gitkeep
