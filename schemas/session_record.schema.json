{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C++ Mastery Session Record",
  "type": "object",
  "required": [
    "record_type",
    "session_id",
    "date",
    "topic_ids",
    "task_ids",
    "attempt_type",
    "hint_level",
    "independence",
    "assessment",
    "evidence",
    "retention"
  ],
  "properties": {
    "record_type": {
      "enum": ["session", "correction", "retention_probe"]
    },
    "session_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "topic_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^T-\\d{3}$" },
      "minItems": 1
    },
    "task_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "attempt_type": {
      "enum": [
        "first_attempt",
        "remediation",
        "transfer",
        "delayed_recall",
        "correction",
        "mixed",
        "unknown"
      ]
    },
    "parent_session_id": {
      "type": ["string", "null"]
    },
    "hint_level": {
      "enum": ["H0", "H1", "H2", "H3", "H4", "unknown"]
    },
    "independence": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": {
          "enum": ["unassisted", "minimal_hint", "scaffolded", "assisted", "unknown"]
        },
        "hints_used": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "process_summary": {
      "type": "object",
      "properties": {
        "problem_interpretation": { "type": "string" },
        "approach_derivation": { "type": "string" },
        "invariant_reasoning": { "type": "string" },
        "complexity_analysis": { "type": "string" }
      }
    },
    "debugging_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symptom", "root_cause", "fix_applied"],
        "properties": {
          "symptom": { "type": "string" },
          "root_cause": { "type": "string" },
          "fix_applied": { "type": "string" },
          "independent_fix": { "type": "boolean" }
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": ["score_percent", "dimensions", "review_status"],
      "properties": {
        "score_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "conceptual_reasoning": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
            "mental_execution": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
            "debugging": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
            "independent_implementation": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
            "transfer": { "type": ["number", "null"], "minimum": 0, "maximum": 5 }
          }
        },
        "proposed_mastery_label": {
          "type": ["string", "null"],
          "enum": [
            "Not assessed",
            "Developing",
            "Recently remediated",
            "Independent",
            "Provisionally mastered",
            "Retention verified",
            null
          ]
        },
        "review_status": {
          "enum": ["pending", "accepted", "rejected", "needs_revision"]
        },
        "reviewed_by_human": { "type": "boolean" },
        "reviewed_at": { "type": ["string", "null"] },
        "summary": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "code_files": { "type": "array", "items": { "type": "string" } },
        "commit_hash": { "type": ["string", "null"] },
        "evidence_snapshot_refs": { "type": "array", "items": { "type": "string" } },
        "test_command": { "type": ["string", "null"] },
        "test_returncode": { "type": ["integer", "null"] },
        "test_output_excerpt": { "type": ["string", "null"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mistakes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["root_cause", "observable_symptom", "correction", "status"],
        "properties": {
          "mistake_id": { "type": ["string", "null"] },
          "taxonomy_class": { "type": "string" },
          "original_incorrect_reasoning": { "type": "string" },
          "root_cause": { "type": "string" },
          "observable_symptom": { "type": "string" },
          "correction": { "type": "string" },
          "reproduced_independently": { "type": "boolean" },
          "recurrence_of": { "type": ["string", "null"] },
          "related_concepts": { "type": "array", "items": { "type": "string" } },
          "status": {
            "enum": [
              "open",
              "remediation_in_progress",
              "corrected_awaiting_retest",
              "resolved_verified_delayed"
            ]
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "properties": {
        "probe_id_attempted": { "type": ["string", "null"] },
        "probe_outcome": {
          "enum": ["passed", "failed", "assisted", "not_applicable", null]
        },
        "probes_scheduled": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic_id", "due_date"],
            "properties": {
              "probe_id": { "type": ["string", "null"] },
              "topic_id": { "type": "string" },
              "due_date": { "type": "string", "format": "date" },
              "interval_days": { "type": "integer", "minimum": 1 },
              "task_summary": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_notes": { "type": "string" }
  },
  "additionalProperties": true
}
